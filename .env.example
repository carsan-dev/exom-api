# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/exom?schema=public
DIRECT_URL=postgresql://user:password@host:5432/exom?schema=public
PRISMA_DATABASE_URL=postgresql://user:password@host:5432/exom?schema=public

# Firebase
FIREBASE_PROJECT_ID=exom-app
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@exom-app.iam.gserviceaccount.com
# Use the Web API Key from Firebase Console -> Project settings -> General
FIREBASE_WEB_API_KEY=

# Resend custom email templates (optional; falls back to Firebase email templates)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_LOGO_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exom-media
# R2_PUBLIC_URL: usar custom domain (ej: https://media.exom.app) en vez de r2.dev
# Configurar en Cloudflare Dashboard: R2 > bucket > Settings > Custom Domains
R2_PUBLIC_URL=https://media.exom.app

# Cloudflare Stream
CF_STREAM_API_TOKEN=
CF_STREAM_ACCOUNT_ID=

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://admin.exommethod.com,https://exommethod.com
APP_BASE_URL=https://exommethod.com
ADMIN_WEB_URL=https://admin.exommethod.com
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.exommethod.exom
IOS_STORE_URL=https://apps.apple.com/app/id0000000000
LATEST_ANDROID_VERSION=1.0.0
LATEST_IOS_VERSION=1.0.0
MIN_ANDROID_BUILD=1
MIN_IOS_BUILD=1
RECOMMENDED_ANDROID_BUILD=1
RECOMMENDED_IOS_BUILD=1
FORCE_ANDROID_UPDATE=false
FORCE_IOS_UPDATE=false
UPDATE_TITLE=Actualizacion disponible
UPDATE_MESSAGE=Hay una nueva version de EXOM disponible.
SUPPORT_URL=https://exommethod.com/support
PRIVACY_POLICY_URL=https://exommethod.com/privacy

# Rate Limiting
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_DURATION_MINUTES=30
