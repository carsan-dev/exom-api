// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum AuthProvider {
  email
  google
  apple
}

enum Level {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

enum MeasureUnit {
  g
  ml
  piece
  tablespoon
  teaspoon
  handful
  slice
  palm
  fist
  ladle
  cold_cut_slice
  glass
  cup
  bowl
  finger
  pinch
  serving
  to_taste
}

enum ChallengeType {
  WEEKLY
  MAIN_GOAL
}

enum ChallengeAssignmentSource {
  MANUAL
  GLOBAL
}

enum AchievementUnlockSource {
  AUTOMATIC
  MANUAL
}

enum RecapStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum FeedbackStatus {
  PENDING
  REVIEWED
}

enum FeedbackKind {
  GENERAL
  LAST_SET
}

enum LastSetVideoPolicy {
  AUTO
  ALWAYS
  NEVER
}

enum ManagedUploadPurpose {
  AVATAR
  FEEDBACK_IMAGE
  FEEDBACK_VIDEO
  EXERCISE_VIDEO
  EXERCISE_THUMBNAIL
  MEAL_IMAGE
}

enum ManagedUploadStatus {
  PENDING
  VERIFIED
  RESERVED
  CONSUMED
  EXPIRED
  FAILED
}

enum MediaType {
  VIDEO
  IMAGE
}

enum NotificationStatus {
  SENT
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum TrainingBlockType {
  CIRCUIT
}

enum TrainingMeasureType {
  REPS
  SECONDS
}

enum CatalogColorType {
  training_type
  diet_nutritional_badge
}

// ─── User & Profile ───────────────────────────────────────────────────────────

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  firebase_uid   String       @unique
  role           Role         @default(CLIENT)
  auth_provider  AuthProvider @default(email)
  is_active      Boolean      @default(true)
  is_locked      Boolean      @default(false)
  login_attempts Int          @default(0)
  locked_at      DateTime?
  fcm_token  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile          Profile?
  adminOf          AdminClientAssignment[] @relation("AdminAssignments")
  clientOf         AdminClientAssignment[] @relation("ClientAssignments")
  dayProgress      DayProgress[]
  bodyMetrics      BodyMetric[]
  streak           Streak?
  weeklyRecaps     WeeklyRecap[]
  clientChallenges ChallengeClient[]
  userAchievements UserAchievement[]
  feedbackMedia    FeedbackMedia[]
  managedUploads   ManagedUpload[]
  sentNotifications     Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  approvalRequestsMade     ApprovalRequest[] @relation("ApprovalRequester")
  approvalRequestsReviewed ApprovalRequest[] @relation("ApprovalReviewer")
  planAssignmentsAsClient PlanAssignment[] @relation("PlanAssignmentClient")
  planAssignmentsAsAdmin  PlanAssignment[] @relation("PlanAssignmentAdmin")
  autoAssignmentRulesAsClient AutoAssignmentRule[] @relation("AutoAssignmentRuleClient")
  autoAssignmentRulesAsAdmin  AutoAssignmentRule[] @relation("AutoAssignmentRuleAdmin")

  @@map("users")
}

model Profile {
  id               String    @id @default(uuid())
  user_id          String    @unique
  first_name       String
  last_name        String
  avatar_url       String?
  level            Level     @default(PRINCIPIANTE)
  main_goal        String?
  muscle_mass_goal Float?
  target_calories  Int?
  current_weight   Float?
  height           Float?
  birth_date       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AdminClientAssignment {
  id         String   @id @default(uuid())
  admin_id   String
  client_id  String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  admin  User @relation("AdminAssignments", fields: [admin_id], references: [id], onDelete: Cascade)
  client User @relation("ClientAssignments", fields: [client_id], references: [id], onDelete: Cascade)

  @@index([admin_id, is_active, created_at, id])
  @@index([client_id, is_active, created_at, id])
  @@index([admin_id, client_id, is_active])
  @@unique([admin_id, client_id])
  @@map("admin_client_assignments")
}

model Notification {
  id           String             @id @default(uuid())
  sender_id    String
  recipient_id String
  title        String
  body         String
  data         Json?
  status       NotificationStatus @default(SENT)
  error        String?
  read_at      DateTime?
  created_at   DateTime           @default(now())

  sender    User @relation("SentNotifications", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedNotifications", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([sender_id, created_at])
  @@index([recipient_id, read_at, created_at])
  @@map("notifications")
}

model NotificationTemplate {
  key         String   @id
  name        String
  description String?
  category    String
  title       String
  body        String
  route       String?
  enabled     Boolean  @default(true)
  variables   String[] @default([])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("notification_templates")
}

model NotificationTemplateSchedule {
  template_key String   @id
  enabled      Boolean  @default(true)
  timezone     String   @default("Europe/Madrid")
  times        String[] @default([])
  weekday      Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("notification_template_schedules")
}

model MobileAppConfig {
  id                        String   @id @default("default")
  android_store_url         String   @default("")
  ios_store_url             String   @default("")
  latest_android_version    String   @default("")
  latest_ios_version        String   @default("")
  min_android_build         Int      @default(0)
  min_ios_build             Int      @default(0)
  recommended_android_build Int      @default(0)
  recommended_ios_build     Int      @default(0)
  force_android_update      Boolean  @default(false)
  force_ios_update          Boolean  @default(false)
  update_title              String   @default("Actualizacion disponible")
  update_message            String   @default("Hay una nueva version de EXOM disponible.")
  support_url               String   @default("")
  privacy_policy_url        String   @default("")
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  @@map("mobile_app_config")
}

model ApprovalRequest {
  id               String         @id @default(uuid())
  requester_id     String
  reviewer_id      String?
  action_type      String
  resource_type    String
  resource_id      String?
  payload          Json
  request_reason   String?
  status           ApprovalStatus @default(PENDING)
  rejection_reason String?
  failure_reason   String?
  resolved_at      DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  requester User  @relation("ApprovalRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  reviewer  User? @relation("ApprovalReviewer", fields: [reviewer_id], references: [id], onDelete: SetNull)
  managedUploads ManagedUpload[]

  @@index([requester_id, status, created_at])
  @@index([status, created_at])
  @@index([resource_type, resource_id, status])
  @@map("approval_requests")
}

// ─── Training & Exercise ──────────────────────────────────────────────────────

model Training {
  id                     String       @id @default(uuid())
  name                   String
  type                   String
  types                  String[]     @default([])
  accentColor            String?
  level                  Level        @default(PRINCIPIANTE)
  estimated_duration_min Int?
  estimated_calories     Int?
  total_volume           Int?
  warmup_description     String?
  warmup_duration_min    Int?
  cooldown_description   String?
  tags                   String[]
  is_active              Boolean      @default(true)
  created_by             String?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt
  group_id               String?

  group       TrainingGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull)
  exercises   TrainingExercise[]
  assignments PlanAssignment[]
  assignmentLinks PlanAssignmentTraining[]
  autoAssignmentRuleDays AutoAssignmentRuleDay[]
  autoAssignmentRuleDayLinks AutoAssignmentRuleDayTraining[]
  blocks                 TrainingBlock[]
  feedbackMedia          FeedbackMedia[]

  @@index([group_id])
  @@map("trainings")
}

model TrainingGroup {
  id              String     @id @default(uuid())
  name            String
  normalized_name String     @unique
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  trainings Training[]

  @@map("training_groups")
}

model TrainingBlock {
  id                                String            @id @default(uuid())
  training_id                       String
  order                             Int
  type                              TrainingBlockType @default(CIRCUIT)
  name                              String?
  rounds                            Int               @default(3)
  rest_between_rounds_seconds       Int               @default(60)
  created_at                        DateTime          @default(now())
  updated_at                        DateTime          @updatedAt

  training  Training           @relation(fields: [training_id], references: [id], onDelete: Cascade)
  exercises TrainingExercise[]

  @@unique([training_id, order])
  @@index([training_id, order])
  @@map("training_blocks")
}

model Exercise {
  id                 String   @id @default(uuid())
  name               String
  muscle_groups      String[]
  equipment          String[]
  level              Level    @default(PRINCIPIANTE)
  video_url          String?
  video_stream_id    String?
  thumbnail_url      String?
  technique_text     String?
  common_errors_text String?
  explanation_text   String?
  is_active          Boolean  @default(true)
  created_by         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  trainingExercises TrainingExercise[]
  feedbackMedia     FeedbackMedia[]

  @@map("exercises")
}

model TrainingExercise {
  id               String @id @default(uuid())
  training_id      String
  block_id         String?
  exercise_id      String
  order            Int
  position_in_block Int?
  sets             Int
  reps_or_duration String
  measure_type     TrainingMeasureType?
  target_value     Int?
  target_rir       Int?
  request_set_tracking Boolean @default(false)
  /// Descanso entre series, en segundos.
  rest_seconds     Int    @default(60)

  training Training @relation(fields: [training_id], references: [id], onDelete: Cascade)
  block    TrainingBlock? @relation(fields: [block_id], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exercise_id], references: [id], onDelete: Restrict)
  feedbackMedia FeedbackMedia[]

  @@unique([training_id, order])
  @@index([block_id, position_in_block])
  @@map("training_exercises")
}

model CatalogColor {
  id             String           @id @default(uuid())
  catalog_type   CatalogColorType
  normalized_key String
  value          String
  color          String
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@unique([catalog_type, normalized_key])
  @@map("catalog_colors")
}

// ─── Diet & Meal & Ingredient ─────────────────────────────────────────────────

model Diet {
  id              String   @id @default(uuid())
  name            String
  tags            String[] @default([])
  total_calories  Int?
  total_protein_g Float?
  total_carbs_g   Float?
  total_fat_g     Float?
  is_active       Boolean  @default(true)
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  group_id        String?

  group       DietGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull)
  meals       Meal[]
  assignments PlanAssignment[]
  autoAssignmentRuleDays AutoAssignmentRuleDay[]

  @@index([group_id])
  @@map("diets")
}

model DietGroup {
  id              String   @id @default(uuid())
  name            String
  normalized_name String   @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  diets Diet[]

  @@map("diet_groups")
}

model Meal {
  id                 String   @id @default(uuid())
  diet_id            String
  parent_meal_id     String?
  type               MealType
  name               String
  image_url          String?
  calories           Int?
  protein_g          Float?
  carbs_g            Float?
  fat_g              Float?
  nutritional_badges String[]
  order              Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  diet        Diet             @relation(fields: [diet_id], references: [id], onDelete: Cascade)
  parent      Meal?            @relation("MealVariants", fields: [parent_meal_id], references: [id], onDelete: Cascade)
  variants    Meal[]           @relation("MealVariants")
  ingredients MealIngredient[]

  @@index([parent_meal_id])
  @@map("meals")
}

model Ingredient {
  id                String   @id @default(uuid())
  name              String
  icon              String?
  calories_per_100g Float
  protein_per_100g  Float
  carbs_per_100g    Float
  fat_per_100g      Float
  is_active         Boolean  @default(true)
  created_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  mealIngredients MealIngredient[]

  @@map("ingredients")
}

model MealIngredient {
  id            String      @id @default(uuid())
  meal_id       String
  ingredient_id String
  quantity      Float
  unit          MeasureUnit @default(g)
  grams_equivalent Float?

  meal       Meal       @relation(fields: [meal_id], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Restrict)

  @@unique([meal_id, ingredient_id])
  @@map("meal_ingredients")
}

// ─── Assignments & Progress ───────────────────────────────────────────────────

model PlanAssignment {
  id          String   @id @default(uuid())
  client_id   String
  admin_id    String?
  date        DateTime @db.Date
  training_id String?
  diet_id     String?
  auto_assignment_rule_id String?
  is_rest_day Boolean  @default(false)
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  training Training? @relation(fields: [training_id], references: [id], onDelete: SetNull)
  trainings PlanAssignmentTraining[]
  diet     Diet?     @relation(fields: [diet_id], references: [id], onDelete: SetNull)
  autoAssignmentRule AutoAssignmentRule? @relation(fields: [auto_assignment_rule_id], references: [id], onDelete: SetNull)
  client   User @relation("PlanAssignmentClient", fields: [client_id], references: [id], onDelete: Cascade)
  admin    User? @relation("PlanAssignmentAdmin", fields: [admin_id], references: [id], onDelete: SetNull)

  @@unique([client_id, date])
  @@index([admin_id])
  @@index([auto_assignment_rule_id])
  @@map("plan_assignments")
}

model PlanAssignmentTraining {
  id            String @id @default(uuid())
  assignment_id String
  training_id   String
  position      Int
  last_set_video_policy LastSetVideoPolicy @default(AUTO)
  requires_last_set_video Boolean @default(false)

  assignment PlanAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  training   Training       @relation(fields: [training_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, training_id])
  @@unique([assignment_id, position])
  @@index([training_id])
  @@map("plan_assignment_trainings")
}

model AutoAssignmentRule {
  id                String   @id @default(uuid())
  client_id         String
  admin_id          String?
  source_week_start DateTime @db.Date
  starts_on         DateTime @db.Date
  ends_on           DateTime? @db.Date
  is_active         Boolean  @default(true)
  deactivated_at    DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  days        AutoAssignmentRuleDay[]
  assignments PlanAssignment[]
  client      User  @relation("AutoAssignmentRuleClient", fields: [client_id], references: [id], onDelete: Cascade)
  admin       User? @relation("AutoAssignmentRuleAdmin", fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([client_id, is_active, starts_on, ends_on])
  @@index([admin_id])
  @@map("auto_assignment_rules")
}

model AutoAssignmentRuleDay {
  id          String  @id @default(uuid())
  rule_id     String
  weekday     Int
  training_id String?
  diet_id     String?
  is_rest_day Boolean @default(false)

  rule     AutoAssignmentRule @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  training Training?          @relation(fields: [training_id], references: [id], onDelete: SetNull)
  trainings AutoAssignmentRuleDayTraining[]
  diet     Diet?              @relation(fields: [diet_id], references: [id], onDelete: SetNull)

  @@unique([rule_id, weekday])
  @@map("auto_assignment_rule_days")
}

model AutoAssignmentRuleDayTraining {
  id          String @id @default(uuid())
  rule_day_id String
  training_id String
  position    Int
  last_set_video_policy LastSetVideoPolicy @default(AUTO)
  requires_last_set_video Boolean @default(false)

  ruleDay  AutoAssignmentRuleDay @relation(fields: [rule_day_id], references: [id], onDelete: Cascade)
  training Training              @relation(fields: [training_id], references: [id], onDelete: Cascade)

  @@unique([rule_day_id, training_id])
  @@unique([rule_day_id, position])
  @@index([training_id])
  @@map("auto_assignment_rule_day_trainings")
}

model DayProgress {
  id                  String   @id @default(uuid())
  client_id           String
  date                DateTime @db.Date
  training_completed  Boolean  @default(false)
  trainings_completed String[] @default([])
  exercises_completed Json     @default("[]")
  meals_completed     String[]
  notes               String?
  admin_reply_text    String?
  admin_reply_sent_at DateTime?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  client User @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, date])
  @@map("day_progress")
}

// ─── Body Metrics ─────────────────────────────────────────────────────────────

model BodyMetric {
  id             String   @id @default(uuid())
  client_id      String
  date           DateTime @default(now()) @db.Date
  weight_kg      Float?
  muscle_mass_kg Float?
  height_cm      Float?
  sleep_hours    Float?
  neck_cm        Float?
  shoulders_cm   Float?
  chest_cm       Float?
  arm_left_cm    Float?
  arm_right_cm   Float?
  forearm_left_cm Float?
  forearm_right_cm Float?
  waist_cm       Float?
  hips_cm        Float?
  thigh_left_cm  Float?
  thigh_right_cm Float?
  calf_left_cm   Float?
  calf_right_cm  Float?
  created_at     DateTime @default(now())

  client User @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, date])
  @@map("body_metrics")
}

// ─── Streak ───────────────────────────────────────────────────────────────────

model Streak {
  id               String    @id @default(uuid())
  client_id        String    @unique
  current_days     Int       @default(0)
  longest_days     Int       @default(0)
  last_active_date DateTime? @db.Date
  tracking_started_at DateTime?
  updated_at       DateTime  @updatedAt

  client User @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@map("streaks")
}

// ─── Weekly Recap ─────────────────────────────────────────────────────────────

model WeeklyRecap {
  id              String   @id @default(uuid())
  client_id       String
  week_start_date DateTime @db.Date
  week_end_date   DateTime @db.Date
  submitted_at    DateTime?

  // Step 1: Training
  training_effort   Int?
  training_sessions Int?
  average_daily_steps Int?
  training_progress String?
  training_notes    String?

  // Step 2: Nutrition
  nutrition_quality String?
  hydration_enabled Boolean @default(false)
  hydration_level   String?
  food_quality      Int?
  nutrition_notes   String?

  // Step 3: Recovery
  sleep_hours_range String?
  fatigue_level     String?
  muscle_pain_zones Json    @default("[]")
  pain_intensity    String?
  recovery_notes    String?

  // Step 4: General feelings
  mood           String?
  stress_enabled Boolean @default(false)
  stress_level   Int?
  general_notes  String?

  // Improvement section
  improvement_app_rating     Int?
  improvement_service_rating Int?
  improvement_areas          String[]
  improvement_feedback_text  String?
  admin_comments             String?
  client_feedback_text       String?
  client_feedback_sent_at    DateTime?
  client_feedback_read_at    DateTime?

  status      RecapStatus @default(DRAFT)
  reviewed_at DateTime?
  archived_at DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  client User @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, week_start_date])
  @@index([client_id, status, archived_at, week_start_date])
  @@map("weekly_recaps")
}

// ─── Challenges ───────────────────────────────────────────────────────────────

model Challenge {
  id           String        @id @default(uuid())
  title        String
  description  String
  type         ChallengeType @default(WEEKLY)
  target_value Float
  unit         String
  is_manual    Boolean       @default(false)
  is_global    Boolean       @default(false)
  deadline     DateTime?     @db.Date
  rule_key     String?
  rule_config  Json?
  created_by   String?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  clients ChallengeClient[]

  @@index([created_by, is_global, is_manual, type, created_at])
  @@map("challenges")
}

model ChallengeClient {
  id                String                    @id @default(uuid())
  challenge_id      String
  client_id         String
  assignment_source ChallengeAssignmentSource @default(MANUAL)
  current_value     Float                     @default(0)
  is_completed      Boolean                   @default(false)
  completed_at      DateTime?
  assigned_at       DateTime                  @default(now())

  challenge Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  client    User      @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, client_id])
  @@index([client_id, is_completed, assigned_at])
  @@index([challenge_id, assignment_source, client_id])
  @@map("challenge_clients")
}

// ─── Achievements ─────────────────────────────────────────────────────────────

model Achievement {
  id             String   @id @default(uuid())
  name           String
  description    String
  icon_url       String?
  criteria_type  String
  criteria_value Float
  rule_config    Json?
  created_by     String?
  created_at     DateTime @default(now())

  userAchievements UserAchievement[]

  @@index([criteria_type])
  @@map("achievements")
}

model UserAchievement {
  id             String                  @id @default(uuid())
  user_id        String
  achievement_id String
  unlocked_at    DateTime                @default(now())
  unlock_source  AchievementUnlockSource @default(AUTOMATIC)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_id])
  @@index([achievement_id, unlock_source])
  @@map("user_achievements")
}

// ─── Feedback Media ───────────────────────────────────────────────────────────

model FeedbackMedia {
  id             String         @id @default(uuid())
  client_id      String
  client_upload_id String?
  exercise_id    String?
  training_id    String?
  training_exercise_id String?
  assignment_date DateTime?      @db.Date
  feedback_kind  FeedbackKind    @default(GENERAL)
  media_type     MediaType
  media_url      String?
  notes          String?
  admin_response String?
  status         FeedbackStatus @default(PENDING)
  reviewed_by    String?
  reviewed_at    DateTime?
  media_deleted_at DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  client   User      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exercise_id], references: [id], onDelete: SetNull)
  training Training? @relation(fields: [training_id], references: [id], onDelete: SetNull)
  trainingExercise TrainingExercise? @relation(fields: [training_exercise_id], references: [id], onDelete: SetNull)

  @@index([status, reviewed_at, media_deleted_at])
  @@index([client_id, assignment_date, training_id, training_exercise_id])
  @@unique([client_id, client_upload_id])
  @@map("feedback_media")
}

model ManagedUpload {
  id             String              @id @default(uuid())
  owner_id       String
  approval_request_id String?
  purpose        ManagedUploadPurpose
  object_key     String              @unique
  mime_type      String
  expected_bytes Int
  actual_bytes   Int?
  status         ManagedUploadStatus @default(PENDING)
  expires_at     DateTime
  verified_at    DateTime?
  consumed_at    DateTime?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  owner User @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest? @relation(fields: [approval_request_id], references: [id], onDelete: SetNull)

  @@index([owner_id, status, expires_at])
  @@index([status, expires_at])
  @@index([approval_request_id, status])
  @@map("managed_uploads")
}
